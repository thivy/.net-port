@model IEnumerable<CardDemo.Models.Card>

@{
    ViewData["Title"] = "Card List";
}

<h1>Card List</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Number</th>
            <th>Expiry Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var card in Model)
        {
            <tr>
                <td>@card.Id</td>
                <td>@card.Number</td>
                <td>@card.ExpiryDate</td>
            </tr>
        }
    </tbody>
</table>
